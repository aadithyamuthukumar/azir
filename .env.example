# Copy to .env and fill in real values. Never commit .env.
ANTHROPIC_API_KEY=your_anthropic_key
OPENAI_API_KEY=your_openai_key

# Optional: Postgres for telemetry persistence. Leave unset to only log telemetry.
# DATABASE_URL=postgresql://user:password@localhost:5432/azir

# Optional: LLM-as-a-judge quality scoring of successful non-streaming
# responses. Each evaluation is an extra paid call to the judge model,
# which must be a concrete model from model_registry.py (not azir-auto).
# LLM_JUDGE_ENABLED=false
# LLM_JUDGE_MODEL=gpt-4o-mini
